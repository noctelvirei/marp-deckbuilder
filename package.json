{
  "name": "marp-deckbuilder",
  "version": "0.1.0",
  "description": "Brandable Marp wrapper for rich HTML slides and native editable PPTX output.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "marp-deckbuilder": "src/cli.js"
  },
  "scripts": {
    "bundle:skill": "node scripts/bundle-skill.mjs",
    "smoke:skill": "node scripts/smoke-skill.mjs",
    "package:skill": "npm run bundle:skill && npm run smoke:skill && node scripts/package-skill.mjs",
    "check": "node --check src/cli.js && node --test",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.3.0",
    "cheerio": "^1.2.0",
    "chromium-bidi": "4.1.1",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.1",
    "playwright-core": "^1.60.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
